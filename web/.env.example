# Copiar a .env.local para desarrollo local con FastAPI.

# true  -> usa src/api/mockClient.js (fixtures en memoria, sin backend)
# false -> usa src/api/httpClient.js (llama al FastAPI real vía fetch)
VITE_USE_MOCK=false

# Dejar vacío para usar el proxy /api de Vite en desarrollo.
# Para una API desplegada, indicar aquí su origen, por ejemplo https://api.example.com
VITE_API_BASE_URL=
